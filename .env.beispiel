# Zugang zu WordPress. Die echte Datei heißt .env und wird NIE zu GitHub hochgeladen.
# Jede Person (Sabine, Simon) legt ihr eigenes Anwendungspasswort an.
# Adresse der Website, mit https://, ohne Schrägstrich am Ende
WP_URL=
# WordPress-Benutzername (oder E-Mail-Adresse) zum Einloggen
WP_BENUTZER=
# Anwendungspasswort: WP-Admin > Benutzer > Profil > Anwendungspasswörter (nicht das Login-Passwort!)
WP_APP_PASSWORT=
# Passwort für die geschützte Vorschau. Bleibt es leer, legt "python3 tools/wp.py check" eines an.
VORSCHAU_PASSWORT=
